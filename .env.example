# Copy to .env.local for local dev, or set these in Vercel project settings.
# Never commit real values.

# --- Broker (Alpaca) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "false" switches to LIVE trading with real money. Anything else = paper.
ALPACA_PAPER=true
# iex (free) or sip (paid, full market volume)
ALPACA_DATA_FEED=iex

# --- Access control ---
# Required in production: the dashboard and APIs return 503 until it is set.
# Use a long random value, e.g. `openssl rand -base64 32`.
DASHBOARD_PASSWORD=
# Optional username; when unset any username is accepted.
DASHBOARD_USER=
# Required in production: Vercel Cron sends it as a bearer token to /api/cron/*.
CRON_SECRET=

# --- Bot ---
# Cap on total position value / equity across all markets (default 5).
MAX_LEVERAGE=5
# "false" pauses new entries/exits (stops at the broker still work).
BOT_ENABLED=true

# --- SMS reports (BulkSMS) ---
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Comma-separated, international format
ALERT_TO_NUMBERS=
BULKSMS_FROM=

# --- Analyst model (Vercel AI Gateway model id) ---
ANALYST_MODEL=anthropic/claude-sonnet-5.5
